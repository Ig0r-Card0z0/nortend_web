# ───────────────────────────────────────────────────────────────
# Nortend site — variáveis de ambiente
# Copie para .env  ( cp .env.example .env )  e preencha os valores.
# ───────────────────────────────────────────────────────────────

# Porta interna da aplicação (o Nginx faz o proxy para ela)
PORT=3000

# Ambiente. Em produção use "production" — isso ativa cookie seguro (HTTPS).
NODE_ENV=production

# Segredo da sessão. Gere um valor aleatório forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# ───────────────────────────────────────────────────────────────
# Senha do admin fixo (use UMA das duas opções abaixo)
# Dica: após definir, aplique rodando:
#   node server.js --bootstrap-admin --reset
# ───────────────────────────────────────────────────────────────

# Opção A — hash bcrypt (RECOMENDADO). Gere com:
#   node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 12))"
# Cole o hash resultante aqui:
ADMIN_PASSWORD_HASH=

# Opção B — senha em texto puro (mais simples, menos seguro).
# Só é usada se ADMIN_PASSWORD_HASH estiver vazio.
ADMIN_PASSWORD=Vida@1205

# ───────────────────────────────────────────────────────────────
# SQLite (usuários, admin, sessões)
# ───────────────────────────────────────────────────────────────

# Caminho do banco SQLite (recomendado: fora de /public)
SQLITE_PATH=./data/app.sqlite

# Tempo de vida da sessão (ms). Ex.: 8h
SESSION_TTL_MS=28800000

# Usuário admin bootstrap (seed)
ADMIN_USERNAME=Admin_nortend
ADMIN_EMAIL=eng.nortend@gmail.com
ADMIN_PHONE=92 993876271
ADMIN_WHATSAPP=92 993876271
